[Unit]
Description=TzEL Rollup Operator
After=network-online.target octez-rollup-node.service
Wants=network-online.target

[Service]
Type=simple
User=tzel
EnvironmentFile=/etc/tzel/shadownet.env
EnvironmentFile=-/usr/local/etc/tzel/rollup-config-admin-build.env
# The DAL transport flags (--dal-node-endpoint, --required-dal-fee,
# --dal-fee-view-material, --dal-fee-address-index) and the reconciler
# (--reconcile-interval-secs) were deleted with the v17 DAL-pointer path;
# the operator is direct-inbox only until the v18 staged submission
# pipeline (StageChunk/SubmitOps, track W4) lands.
ExecStart=${TZEL_OPERATOR_BIN} \
  --listen=${TZEL_OPERATOR_LISTEN} \
  --source-alias=${TZEL_SOURCE_ALIAS} \
  --state-dir=${TZEL_OPERATOR_STATE_DIR} \
  --bearer-token-file=${TZEL_OPERATOR_BEARER_TOKEN_FILE} \
  --octez-client-bin=${TZEL_OCTEZ_CLIENT_BIN} \
  --octez-client-dir=${TZEL_OCTEZ_CLIENT_DIR} \
  --octez-node-endpoint=${TZEL_L1_RPC_URL}
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
