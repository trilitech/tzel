# Shared config for the PQPark (pqnet-10-16) operator box.
#
# Network dashboard: https://pqnet-10-16.pqpark.dal.nomadic-labs.com/
# PQ-Octez image:    europe-west1-docker.pkg.dev/nl-dal/pqpark/pq-octez:octez-20261016-30d8a549c6

TZEL_OCTEZ_NODE_BIN=/usr/local/bin/octez-node
TZEL_OCTEZ_CLIENT_BIN=/usr/local/bin/octez-client
TZEL_DAL_NODE_BIN=/usr/local/bin/octez-dal-node
TZEL_ROLLUP_NODE_BIN=/usr/local/bin/octez-smart-rollup-node
TZEL_OPERATOR_BIN=/usr/local/bin/tzel-operator
TZEL_DETECT_BIN=/usr/local/bin/tzel-detect

TZEL_OCTEZ_NETWORK=https://pqnet-10-16.pqpark.dal.nomadic-labs.com/network.json
TZEL_OCTEZ_PROTOCOL=ProtoALphaALphaALphaALphaALphaALphaALphaALphaDdp3zK

# IMPORTANT: Use an ed25519 (tz1...) alias for L1 manager operations and
# rollup outbox withdrawals.
TZEL_SOURCE_ALIAS=tzelpqnet
TZEL_ROLLUP_ADDRESS=sr1REPLACE_ME
TZEL_BRIDGE_TICKETER=KT1REPLACE_ME

TZEL_L1_RPC_URL=http://127.0.0.1:8732
TZEL_OCTEZ_CLIENT_DIR=/var/lib/tzel/octez-client

TZEL_OCTEZ_NODE_DATA_DIR=/var/lib/tzel/octez-node
TZEL_OCTEZ_NODE_RPC_ADDR=127.0.0.1:8732
TZEL_OCTEZ_NODE_NET_ADDR=0.0.0.0:9732

TZEL_DAL_DATA_DIR=/var/lib/tzel/octez-dal-node
TZEL_DAL_RPC_ADDR=127.0.0.1:10732
TZEL_DAL_NET_ADDR=0.0.0.0:11732
TZEL_DAL_PUBLIC_ADDR=PUBLIC_IP_OR_DNS:11732
TZEL_DAL_BOOTSTRAP_PEER=34.76.143.72:11736
# pqnet-10-16 has number_of_slots=4 (indices 0..3) and in-cluster producer-0
# publishes on slot 0 every 4 blocks; reserve slots 1,2,3 for TzEL.
TZEL_DAL_OPERATOR_PROFILES=1,2,3

TZEL_ROLLUP_DATA_DIR=/var/lib/tzel/octez-rollup-node
TZEL_ROLLUP_RPC_HOST=127.0.0.1
TZEL_ROLLUP_RPC_PORT=28944

TZEL_OPERATOR_STATE_DIR=/var/lib/tzel/operator
TZEL_OPERATOR_LISTEN=127.0.0.1:8787
TZEL_OPERATOR_BEARER_TOKEN_FILE=/etc/tzel/operator-bearer-token
TZEL_OPERATOR_REQUIRED_DAL_FEE=100000
TZEL_OPERATOR_DAL_FEE_VIEW_MATERIAL=/etc/tzel/operator-dal-fee.view.json
TZEL_OPERATOR_DAL_FEE_ADDRESS_FILE=/etc/tzel/operator-dal-fee-address.json
TZEL_OPERATOR_DAL_FEE_ADDRESS_INDEX=0
TZEL_OPERATOR_DAL_SLOT_RANGE=1..4
TZEL_OPERATOR_RECONCILE_INTERVAL_SECS=6

TZEL_DETECT_ENABLE=0
TZEL_DETECT_WALLET=/var/lib/tzel/watch/alice.watch.json
TZEL_DETECT_LISTEN=127.0.0.1:8789
TZEL_DETECT_INTERVAL_SECS=15
